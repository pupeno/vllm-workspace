{
    "name": "vllm",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

    "features": {
        // Install node.
        "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
        // Install the GitHub CLI.
        "ghcr.io/devcontainers/features/github-cli:1": {},
        // Match the CUDA version used by vLLM's current development wheels.
        "ghcr.io/devcontainers/features/nvidia-cuda:3": {
            "installToolkit": true,
            "cudaVersion": "13.0",
            "installCudnn": true,
            "installCudnnDev": true
        }
    },

    // Fixes the hostname, exposes the host GPU(s), and gives PyTorch enough
    // shared memory for multiprocessing and tensor-parallel workloads.
    "runArgs": [
        "--hostname", "vllm",
        "--runtime", "nvidia",
        "--gpus", "all",
        "--ipc", "host"
    ],

    "mounts": [
        // One volume for the whole container home so config and model caches
        // survive a rebuild.
        "source=vllm-home,target=/home/vscode,type=volume"
    ],

    // Keep uv's cache on the workspace filesystem so it can hardlink packages
    // into the project virtual environment.
    "containerEnv": {
        "UV_CACHE_DIR": "${containerWorkspaceFolder}/.uv-cache",
        "CUDA_DEVICE_ORDER": "PCI_BUS_ID"
    },

    "remoteEnv": {
        "CUDA_HOME": "/usr/local/cuda",
        "PATH": "/usr/local/cuda/bin:${containerEnv:PATH}",
        "MAX_JOBS": "8"
    },

    "postCreateCommand": ".devcontainer/post-create.sh",
    "remoteUser": "vscode"
}
